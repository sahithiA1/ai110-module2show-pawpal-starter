classDiagram
    %% PawPal+ initial design. Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet_name: str) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +get_pending_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str preferred_time
        +str time
        +date due_date
        +str pet_name
        +bool completed
        +str recurrence
        +mark_complete() None
        +priority_value() int
        +next_occurrence() Task
    }

    class Scheduler {
        +Owner owner
        +list~Task~ scheduled_tasks
        +list~Task~ skipped_tasks
        +collect_tasks() list~Task~
        +sort_tasks(tasks: list~Task~) list~Task~
        +build_daily_plan() list~Task~
        +total_scheduled_minutes() int
        +explain_plan() str
        +detect_conflicts() list~str~
        +complete_task(pet: Pet, task: Task) Task
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : needs
    Scheduler "1" --> "1" Owner : plans for
    Scheduler --> "0..*" Task : schedules
    Task ..> Task : next_occurrence creates
