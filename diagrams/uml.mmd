classDiagram
    %% PawPal+ final design (Phase 4). Matches the classes in pawpal_system.py.
    %% Task validates its time ("HH:MM" or empty) in __post_init__ when it is created.
    %% Module helper (not a class): time_to_minutes(hhmm: str) int, used by sort_by_time() and detect_conflicts().

    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet_name: str) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +get_pending_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str preferred_time
        +str time
        +date due_date
        +str pet_name
        +bool completed
        +str recurrence
        +mark_complete() None
        +priority_value() int
        +next_occurrence() Optional~Task~
        +identity() tuple
    }

    class Scheduler {
        +Owner owner
        +list~Task~ scheduled_tasks
        +list~Task~ skipped_tasks
        +date plan_date
        -dict _reasons
        +collect_tasks() list~Task~
        +sort_tasks(tasks: list~Task~) list~Task~
        +sort_by_time(tasks: list~Task~) list~Task~
        +filter_tasks(pet_name: str, completed: bool) list~Task~
        +build_daily_plan() list~Task~
        +total_scheduled_minutes() int
        +explain_plan() str
        +detect_conflicts() list~str~
        +complete_task(pet: Pet, task: Task) Optional~Task~
        -_is_preferred(task: Task) bool
        -_schedule_reason(task: Task) str
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : needs
    Scheduler "1" --> "1" Owner : plans for
    Scheduler --> "0..*" Task : schedules
    Task ..> Task : next_occurrence creates
